# Public surface
PUBLIC_URL=https://efactura.example.com
BASE_PATH=/v1
HOST_PORT=3000
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# Gateway auth (Authorization: Bearer <API_KEY>)
API_KEY=change-me

# Upstream eFactura SOAP (defaults; overridable per-request via X-Provider-Credentials)
EFACTURA_ENDPOINT=https://efactura-api.sfs.md/Service.svc
EFACTURA_USERNAME=
EFACTURA_PASSWORD=

# Resilience
SOAP_TIMEOUT_MS=30000
SOAP_CONNECT_TIMEOUT_MS=10000
READ_MAX_RETRIES=4
READ_BACKOFF_BASE_MS=500
READ_BACKOFF_MAX_MS=8000
# Writes are NEVER auto-retried on timeout/ambiguous failure
WRITE_TIMEOUT_MS=45000

# Idempotency ledger + OAuth store (SQLite; mount a volume in production)
DATABASE_PATH=./data/idempotency.db
OAUTH_DATABASE_PATH=./data/oauth.db

# Async invoice posts via BullMQ (requires Redis). Clients opt in with `Prefer: respond-async`.
QUEUE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# MCP endpoint (/mcp) with OAuth 2.1 + PKCE for AI clients
MCP_ENABLED=true
# 32+ chars each; required when NODE_ENV=production (generate: openssl rand -hex 32)
ENCRYPTION_KEY=
TOKEN_SIGNING_KEY=
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# MCP issue reports (efactura_report_issue). Masked text only; set false to opt out.
FEEDBACK_ENABLED=true
# Empty = the maintainers' relay; set to your own relay/ deployment to receive reports yourself.
FEEDBACK_URL=

# Cloudflare Tunnel (docker-compose.prod.yml --profile tunnel); token from Zero Trust → Networks → Tunnels
TUNNEL_TOKEN=

# Logging
LOG_LEVEL=info
LOG_CHANNEL=efactura
